LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Moss — semantic search / memory (https://docs.moss.dev/docs)
# MOSS_PROJECT_ID / MOSS_PROJECT_KEY are filled in at index/run time (Task 9).
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
MOSS_INDEX_NAME=knowledge
MOSS_MEMORY_INDEX_NAME=memory
MOSS_PROTOCOL_INDEX_NAME=protocols
MOSS_EXPERT_INDEX_NAME=kol_experts
MOSS_MODEL_ID=moss-minilm

# OpenAI Agents SDK — optional for local demos. If omitted, KOL Copilot uses a
# deterministic synthetic fallback so the voice/UI flow can still be exercised.
OPENAI_API_KEY=
OPENAI_KOL_MODEL=gpt-5.2
KOL_COPILOT_STRICT_OPENAI=0
